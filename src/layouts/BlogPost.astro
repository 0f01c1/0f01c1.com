---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ScrollToTopButton from "../components/ScrollToTopButton.astro";
import TagLink from "../components/TagLink.astro";
import TableOfContents from "../components/TableOfContents.astro";
import readingTime from "reading-time";
import { formatTitle } from "../consts";

type Props = CollectionEntry<"blog">["data"] & {
  body: string;
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, heroImage, tags, body, headings } = Astro.props;
const stats = readingTime(body);
---

<BaseLayout title={formatTitle(title)} description={description}>
  <article class="relative">
        <h1 id="post-title" class="text-5xl mb-2">
          {title}
        </h1>
        <div>
          <FormattedDate date={pubDate} />
          <span class="text-muted text-sm font-medium tracking-wide"> / {stats.text}</span>
        </div>
        <div class="mb-4">
          {
            tags && (
                <ul class="flex gap-2">
                  {tags.map((tag) => (
                    <li>
                      <TagLink tag={tag} />
                    </li>
                  ))}
                </ul>
            )
          }
        </div>
        <div>
          {
            heroImage && (
              <img width={1020} height={510} src={heroImage} alt="" style="max-width: 100%; margin: 20px 0;" />
            )
          }
        </div>
        {headings && <TableOfContents headings={headings} />}
        <div class="mt-10">
          <slot />
        </div>
      </article>
      <ScrollToTopButton />
</BaseLayout>

<style is:inline>
@layer base {
    /* Base Styles */
img {
    max-width: 85%;
    height: auto;
    display: block;
    margin: 20px auto;
}

/* Headings */
h1, h2, h3, h4, h5, h6 {
    margin-top: 24px;
    margin-bottom: 16px;
    font-weight: bold;
}

#post-title {
    margin-top: 0;
}

h1 { font-size: 32px; }
h2 { font-size: 28px; }
h3 { font-size: 24px; }
h4 { font-size: 20px; }
h5 { font-size: 18px; }
h6 { font-size: 16px; }

/* Paragraphs */
p {
    margin-top: 0;
    margin-bottom: 16px;
}

/* Blockquotes */
blockquote {
    border-left: 4px solid var(--line);
    padding: 10px 20px;
    margin: 20px 0;
    color: var(--body);
    background-color: var(--surface);
}

blockquote p {
    margin: 0;
}

/* Code Blocks and Inline Code */

pre {
    padding: 10px;
    overflow-x: auto;
    margin-top: 0;
    margin-bottom: 16px;
}

code {
    padding: 2px 4px;
    font-family: 'Courier New', monospace;
    font-size: 90%;
}

.expressive-code {
    margin-bottom: 1rem;
}

/* Tables */
table {
    width: 100%;
    margin-bottom: 20px;
    border-collapse: collapse;
}

th, td {
    padding: 8px;
    border: 1px solid var(--line);
}

th {
    background-color: var(--surface);
}

/* Lists */
article > div:last-of-type ul,
article > div:last-of-type ol {
    margin-top: 0;
    margin-bottom: 16px;
    padding-left: 20px;
    list-style: inside;
}

article > div:last-of-type ul {
    list-style-type: disc;
}

article > div:last-of-type ol {
    list-style-type: decimal;
}

/* Links */
article a {
    text-decoration: underline;
}

article a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
}

/* Footnotes */
article .footnotes > h2 {
  display: none;
}

article .footnotes ol {
    list-style: decimal;
}

article .footnotes li p {
    display: inline;
    margin: 0;
}

/* Special HTML Tags */
abbr {
    border-bottom: 1px dotted var(--muted);
    cursor: help;
}

kbd {
    padding: 2px 4px;
    font-size: 90%;
    color: #fff;
    background-color: #333;
    border-radius: 3px;
}

mark {
    background-color: yellow;
    color: black;
}

sup, sub {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
}

sup { top: -0.5em; }
sub { bottom: -0.25em; }
}
</style>
