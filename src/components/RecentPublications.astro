---
import { getCollection } from "astro:content";
import PostList from "./PostList.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
let numberOfPostsToDisplay = 3;
let recentPosts = posts.slice(0, numberOfPostsToDisplay);
---

<div class="flex flex-col mt-16">
  <h2 class="text-2xl mb-8 font-bold">Recent Posts</h2>
  <PostList posts={recentPosts} />
  <a
    class="border border-line flex justify-center items-center hover:no-underline bg-surface hover:bg-surface-hover w-full max-w-xs mx-auto mt-12 rounded-lg text-secondary hover:text-strong text-xs h-8 font-medium"
    href="/blog">View more</a
  >
</div>
